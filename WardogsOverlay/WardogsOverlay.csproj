<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WardogsOverlay</AssemblyName>
    <RootNamespace>WardogsOverlay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Минимум ресурсов: обычный (не серверный) GC без фонового потока, экономия памяти -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Свои элементы без дизайнера форм: атрибуты сериализации для дизайнера не нужны -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <EmbeddedResource Include="assets\app.ico" LogicalName="WardogsOverlay.app.ico" />
    <EmbeddedResource Include="assets\names-ru.json" LogicalName="WardogsOverlay.names-ru.json" />
    <EmbeddedResource Include="assets\fonts\*.ttf" LogicalName="WardogsOverlay.fonts.%(Filename).ttf" />
    <None Include="assets\fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="licenses\%(Filename)%(Extension)" />
    <None Remove="assets\preview.png" />
  </ItemGroup>

</Project>
